@page "/"
@inject IJSRuntime JSRuntime
@inject KanbanService Kanban
@using task_board_client.Models
@using task_board_client.Services
@implements IDisposable

<PageTitle>Tablero Kanban</PageTitle>

@if (errorMessage != null)
{
    <div class="toast toast-error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@errorMessage</span>
        <button class="toast-dismiss" @onclick="() => errorMessage = null">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
}

@if (successMessage != null)
{
    <div class="toast toast-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>@successMessage</span>
        @if (lastAction != null)
        {
            <button class="toast-undo" @onclick="Undo">Deshacer</button>
        }
    </div>
}

@if (isLoading && columns == null)
{
    <div class="loading-board">
        <div class="spinner"></div>
        <p>Cargando tablero...</p>
    </div>
}
else if (columns != null)
{
    <div class="board-title-bar">
        <span class="board-section-title">Board</span>
        @if (isLoading)
        {
            <span class="loading-indicator">
                <div class="spinner-mini"></div>
                Guardando...
            </span>
        }
        <div class="search-wrapper">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text"
                   class="search-input"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   placeholder="Buscar tareas..." />
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button class="search-clear" @onclick="() => searchTerm = string.Empty">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            }
        </div>
    </div>

    <div class="kanban-board">
        @foreach (var column in columns)
        {
            <div class="kanban-column">

                <ColumnHeader Title="@column.Name"
                              Renamed="(newName) => RenameColumn(column.Id, newName)"
                              Deleted="() => ConfirmDeleteColumn(column.Id, column.Name)" />

                <div class="task-list"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(column.Id)">
                    @for (var i = 0; i < GetFilteredTasks(column).Count; i++)
                    {
                        var task = GetFilteredTasks(column)[i];
                        var index = i;
                        <div class="drop-zone @(dragOverColumnId == column.Id && dragOverIndex == index ? "drop-zone-active" : "")"
                             ondragover="event.preventDefault();"
                             @ondragenter="() => SetDragOver(column.Id, index)"
                             @ondrop="() => HandleDropAt(column.Id, index)">
                            <TaskCard Task="task"
                                      LabelClass="@GetLabelClass(task.Id)"
                                      DragStarted="HandleDragStart"
                                      DeleteClicked="ConfirmDeleteTask"
                                      EditClicked="OpenEditModal" />
                        </div>
                    }
                    <div class="drop-zone @(dragOverColumnId == column.Id && dragOverIndex == column.Tasks.Count ? "drop-zone-active" : "")"
                         ondragover="event.preventDefault();"
                         @ondragenter="() => SetDragOver(column.Id, column.Tasks.Count)"
                         @ondrop="() => HandleDropAt(column.Id, column.Tasks.Count)">
                    </div>
                </div>

                <AddCardForm IsVisible="showAddCard.ContainsKey(column.Id) && showAddCard[column.Id]"
                             ToggleVisibility="() => ToggleAddCard(column.Id)"
                             SubmitCard="(title) => CreateTask(column.Id, title)" />
            </div>
        }

        <AddColumnForm IsVisible="showAddColumn"
                       ToggleVisibility="() => showAddColumn = !showAddColumn"
                       SubmitColumn="CreateColumn" />
    </div>
}

<TaskDetailModal IsVisible="editModalVisible"
                Task="editingTask"
                ColumnNames="columnNames"
                Cancel="CloseEditModal"
                Save="UpdateTask" />

<style>
    .toast {
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        animation: slideIn 0.2s ease-out;
    }

    .toast-error {
        background: #ffeceb;
        border: 1px solid #ff5630;
        color: #ae1e09;
    }

    .toast-success {
        background: #e3fcef;
        border: 1px solid #36b37e;
        color: #006644;
    }

    .toast-dismiss {
        margin-left: auto;
        background: none;
        border: none;
        cursor: pointer;
        padding: 2px;
        border-radius: 4px;
        display: flex;
        align-items: center;
    }

    .toast-dismiss:hover {
        background: rgba(0, 0, 0, 0.06);
    }

    .toast-success .toast-dismiss {
        color: #006644;
    }

    .toast-undo {
        margin-left: 8px;
        background: rgba(0, 102, 68, 0.1);
        border: 1px solid rgba(0, 102, 68, 0.3);
        color: #006644;
        padding: 2px 10px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }

    .toast-undo:hover {
        background: rgba(0, 102, 68, 0.2);
    }

    .loading-board {
        color: white;
        text-align: center;
        margin-top: 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .spinner-mini {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .loading-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.75rem;
        font-weight: 400;
        margin-left: 8px;
    }

    .board-title-bar {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .board-section-title {
        color: white;
        font-weight: 700;
        font-size: 1rem;
        background: rgba(255,255,255,0.2);
        padding: 6px 14px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        margin-left: auto;
    }

    .search-icon {
        position: absolute;
        left: 10px;
        color: rgba(255, 255, 255, 0.6);
        pointer-events: none;
    }

    .search-input {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 6px;
        padding: 6px 30px 6px 30px;
        color: white;
        font-size: 0.85rem;
        outline: none;
        width: 200px;
        transition: background 0.15s, border-color 0.15s, width 0.2s;
    }

    .search-input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .search-input:focus {
        background: rgba(255, 255, 255, 0.3);
        border-color: rgba(255, 255, 255, 0.5);
        width: 260px;
    }

    .search-clear {
        position: absolute;
        right: 6px;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        padding: 2px;
        border-radius: 3px;
        display: flex;
        align-items: center;
    }

    .search-clear:hover {
        background: rgba(255, 255, 255, 0.15);
        color: white;
    }

    .kanban-board {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding-bottom: 16px;
    }

    .kanban-column {
        background: #f1f2f4;
        border-radius: 12px;
        width: 272px;
        min-width: 272px;
        padding: 8px;
        box-shadow: 0 1px 1px rgba(9, 30, 66, 0.25);
    }

    .task-list {
        min-height: 8px;
        margin-top: 4px;
    }

    .drop-zone {
        border-radius: 8px;
        transition: background 0.15s, border-color 0.15s;
        min-height: 4px;
    }

    .drop-zone-active {
        background: rgba(12, 102, 228, 0.12);
        border: 2px dashed #0c66e4;
        min-height: 40px;
    }

    .kanban-board::-webkit-scrollbar {
        height: 8px;
    }

    .kanban-board::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.1);
        border-radius: 4px;
    }

    .kanban-board::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.3);
        border-radius: 4px;
    }

    .kanban-board::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.5);
    }

    @@media (max-width: 640px) {
        .kanban-board {
            gap: 10px;
            padding-bottom: 80px;
        }

        .kanban-column {
            width: 260px;
            min-width: 260px;
            padding: 6px;
        }

        .board-title-bar {
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .search-wrapper {
            width: 100%;
            order: 3;
        }

        .search-input,
        .search-input:focus {
            width: 100%;
        }

        .toast {
            font-size: 0.8rem;
            padding: 8px 10px;
        }

        .drop-zone-active {
            min-height: 32px;
        }
    }
</style>

@code {
    private List<ColumnItem>? columns;
    private Dictionary<int, bool> showAddCard = new();
    private int draggedTaskId;
    private string? errorMessage;
    private string? successMessage;
    private bool editModalVisible;
    private TaskItem? editingTask;
    private int dragOverColumnId;
    private int dragOverIndex;
    private bool showAddColumn;
    private bool isLoading;
    private string searchTerm = string.Empty;
    private Dictionary<int, string> columnNames = new();
    private UndoAction? lastAction;
    private CancellationTokenSource? undoTimerCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoard();
    }

    public void Dispose()
    {
        undoTimerCts?.Cancel();
        undoTimerCts?.Dispose();
    }

    private async Task LoadBoard()
    {
        try
        {
            errorMessage = null;
            columns = await Kanban.GetBoardAsync();
            if (columns != null)
            {
                columnNames = columns.ToDictionary(c => c.Id, c => c.Name);
                foreach (var col in columns)
                {
                    if (!showAddCard.ContainsKey(col.Id))
                        showAddCard[col.Id] = false;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo conectar con el servidor: {ex.Message}";
        }
    }

    private string GetLabelClass(int taskId)
    {
        var labels = new[] { "label-yellow", "label-blue", "label-green", "label-pink", "label-purple", "label-orange" };
        return labels[taskId % labels.Length];
    }

    private List<TaskItem> GetFilteredTasks(ColumnItem column)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            return column.Tasks;

        var term = searchTerm.ToLowerInvariant();
        return column.Tasks
            .Where(t => t.Title.ToLowerInvariant().Contains(term)
                     || t.Description.ToLowerInvariant().Contains(term))
            .ToList();
    }

    private void ToggleAddCard(int columnId)
    {
        if (showAddCard.ContainsKey(columnId))
            showAddCard[columnId] = !showAddCard[columnId];
    }

    private void HandleDragStart(int taskId)
    {
        draggedTaskId = taskId;
    }

    private void SetDragOver(int columnId, int index)
    {
        dragOverColumnId = columnId;
        dragOverIndex = index;
    }

    private async Task HandleDrop(int targetColumnId)
    {
        if (draggedTaskId == 0) return;
        await HandleDropAt(targetColumnId, -1);
    }

    private async Task HandleDropAt(int targetColumnId, int targetIndex)
    {
        if (draggedTaskId == 0) return;

        try
        {
            if (columns == null) return;

            var draggedTask = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == draggedTaskId);
            if (draggedTask == null) return;

            var isSameColumn = draggedTask.ColumnId == targetColumnId;

            if (isSameColumn && targetIndex >= 0)
            {
                var currentIndex = columns.First(c => c.Id == targetColumnId)
                    .Tasks.FindIndex(t => t.Id == draggedTaskId);

                if (currentIndex == targetIndex || currentIndex == targetIndex - 1)
                {
                    draggedTaskId = 0;
                    dragOverColumnId = 0;
                    dragOverIndex = 0;
                    return;
                }

                var adjustedIndex = targetIndex > currentIndex ? targetIndex - 1 : targetIndex;

                var dto = new ReorderTaskDto
                {
                    TaskId = draggedTaskId,
                    TargetColumnId = targetColumnId,
                    NewOrder = adjustedIndex
                };
                await Kanban.ReorderTaskAsync(dto);
            }
            else
            {
                var originalColumnId = draggedTask.ColumnId;
                var moveDto = new MoveTaskDto { TaskId = draggedTaskId, TargetColumnId = targetColumnId };
                await Kanban.MoveTaskAsync(moveDto);

                SetUndo(new UndoAction
                {
                    Type = UndoType.Move,
                    TaskId = draggedTaskId,
                    ColumnId = originalColumnId
                });
            }

            draggedTaskId = 0;
            dragOverColumnId = 0;
            dragOverIndex = 0;
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al mover la tarea: {ex.Message}";
        }
    }

    private async Task CreateTask(int columnId, string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            var newTask = new TaskItem
            {
                Title = title,
                Description = "Nueva tarea",
                ColumnId = columnId,
                Order = 1
            };

            var response = await Kanban.CreateTaskAsync(newTask);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al crear la tarea. Inténtalo de nuevo.";
                return;
            }

            showAddCard[columnId] = false;
            ShowSuccess("Tarea creada correctamente");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteTask(int taskId)
    {
        if (columns == null) return;

        var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (task == null) return;

        var message = $"¿Eliminar la tarea \"{task.Title}\"?";

        if (await JSRuntime.InvokeAsync<bool>("confirm", message))
        {
            await DeleteTask(taskId);
        }
    }

    private async Task DeleteTask(int taskId)
    {
        try
        {
            if (columns == null) return;
            var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
            if (task == null) return;

            var columnId = task.ColumnId;
            var order = task.Order;

            isLoading = true;
            StateHasChanged();

            var response = await Kanban.DeleteTaskAsync(taskId);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al eliminar la tarea. Inténtalo de nuevo.";
                return;
            }

            SetUndo(new UndoAction
            {
                Type = UndoType.Delete,
                TaskId = taskId,
                TaskData = task,
                ColumnId = columnId,
                Order = order
            });

            ShowSuccess("Tarea eliminada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenEditModal(int taskId)
    {
        if (columns == null) return;
        editingTask = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (editingTask != null)
            editModalVisible = true;
    }

    private void CloseEditModal()
    {
        editModalVisible = false;
        editingTask = null;
    }

    private async Task UpdateTask(UpdateTaskDto dto)
    {
        if (editingTask == null) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await Kanban.UpdateTaskAsync(editingTask.Id, dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al actualizar la tarea. Inténtalo de nuevo.";
                return;
            }

            CloseEditModal();
            ShowSuccess("Tarea actualizada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al actualizar la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateColumn(string name)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new CreateColumnDto { Name = name };
            var response = await Kanban.CreateColumnAsync(dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al crear la columna. Inténtalo de nuevo.";
                return;
            }

            showAddColumn = false;
            ShowSuccess("Columna creada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear la columna: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RenameColumn(int columnId, string newName)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new UpdateColumnDto { Name = newName };
            var response = await Kanban.UpdateColumnAsync(columnId, dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al renombrar la columna. Inténtalo de nuevo.";
                return;
            }

            ShowSuccess("Columna renombrada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al renombrar la columna: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteColumn(int columnId, string columnName)
    {
        if (columns == null) return;

        var column = columns.FirstOrDefault(c => c.Id == columnId);
        var taskCount = column?.Tasks.Count ?? 0;

        var message = taskCount > 0
            ? $"¿Eliminar la columna \"{columnName}\" y sus {taskCount} tarea(s)?"
            : $"¿Eliminar la columna \"{columnName}\"?";

        if (await JSRuntime.InvokeAsync<bool>("confirm", message))
        {
            await DeleteColumn(columnId);
        }
    }

    private async Task DeleteColumn(int columnId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await Kanban.DeleteColumnAsync(columnId);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al eliminar la columna. Inténtalo de nuevo.";
                return;
            }

            ShowSuccess("Columna eliminada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la columna: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowSuccess(string message)
    {
        _ = ShowSuccessInternal(message);
    }

    private async Task ShowSuccessInternal(string message)
    {
        successMessage = message;
        StateHasChanged();
        await Task.Delay(2500);
        successMessage = null;
        StateHasChanged();
    }

    private void SetUndo(UndoAction action)
    {
        undoTimerCts?.Cancel();
        undoTimerCts?.Dispose();
        undoTimerCts = new CancellationTokenSource();
        lastAction = action;

        _ = AutoClearUndo(undoTimerCts.Token);
    }

    private async Task AutoClearUndo(CancellationToken ct)
    {
        try
        {
            await Task.Delay(10000, ct);
            lastAction = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task Undo()
    {
        if (lastAction == null) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            switch (lastAction.Type)
            {
                case UndoType.Delete:
                    var restoredTask = new TaskItem
                    {
                        Title = lastAction.TaskData!.Title,
                        Description = lastAction.TaskData.Description,
                        ColumnId = lastAction.ColumnId,
                        Order = lastAction.Order,
                        DueDate = lastAction.TaskData.DueDate,
                        Labels = lastAction.TaskData.Labels
                    };
                    await Kanban.CreateTaskAsync(restoredTask);
                    ShowSuccess("Acción deshecha");
                    break;

                case UndoType.Move:
                    var moveBack = new MoveTaskDto
                    {
                        TaskId = lastAction.TaskId,
                        TargetColumnId = lastAction.ColumnId
                    };
                    await Kanban.MoveTaskAsync(moveBack);
                    ShowSuccess("Acción deshecha");
                    break;
            }

            lastAction = null;
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al deshacer: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class UndoAction
    {
        public UndoType Type { get; set; }
        public int TaskId { get; set; }
        public TaskItem? TaskData { get; set; }
        public int ColumnId { get; set; }
        public int Order { get; set; }
    }

    private enum UndoType
    {
        Delete,
        Move
    }
}
