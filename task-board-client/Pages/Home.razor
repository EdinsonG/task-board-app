@page "/"
@inject IJSRuntime JSRuntime
@inject KanbanService Kanban
@using task_board_client.Models
@using task_board_client.Services
@implements IDisposable

<PageTitle>Tablero Kanban</PageTitle>

<div class="toast-container">
    @if (errorMessage != null)
    {
        <div class="toast toast-error">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@errorMessage</span>
            <button class="toast-dismiss" @onclick="() => errorMessage = null">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }

    @if (successMessage != null)
    {
        <div class="toast toast-success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>@successMessage</span>
            @if (lastAction != null)
            {
                <button class="toast-undo" @onclick="Undo">Deshacer</button>
            }
            <button class="toast-dismiss" @onclick="() => successMessage = null">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }
</div>

@if (isLoading && columns == null)
{
    <div class="loading-board">
        <div class="spinner"></div>
        <p>Cargando tablero...</p>
    </div>
}
else if (columns != null)
{
    <div class="board-title-bar">
        <span class="board-section-title">Board</span>
        @if (isLoading)
        {
            <span class="loading-indicator">
                <div class="spinner-mini"></div>
                Guardando...
            </span>
        }
        <div class="search-wrapper">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text"
                   class="search-input"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   placeholder="Buscar tareas..." />
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button class="search-clear" @onclick="() => searchTerm = string.Empty">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            }
        </div>
        <div class="shortcuts-help" @onclick="ToggleShortcutsHelp">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
                <path d="M6 8h.001"></path><path d="M10 8h.001"></path><path d="M14 8h.001"></path>
                <path d="M8 12h.001"></path><path d="M12 12h.001"></path><path d="M16 12h.001"></path>
                <path d="M7 16h10"></path>
            </svg>
            @if (showShortcuts)
            {
                <div class="shortcuts-tooltip">
                    <div class="shortcuts-title">Atajos de teclado</div>
                    <div class="shortcut-row"><kbd>N</kbd> Nueva columna</div>
                    <div class="shortcut-row"><kbd>E</kbd> Editar primera tarea</div>
                    <div class="shortcut-row"><kbd>Ctrl+Z</kbd> Deshacer</div>
                    <div class="shortcut-row"><kbd>Esc</kbd> Cerrar modal</div>
                </div>
            }
        </div>
    </div>

    <div class="kanban-board">
        @foreach (var column in columns)
        {
            <div class="kanban-column">

                <ColumnHeader Title="@column.Name"
                              Renamed="(newName) => RenameColumn(column.Id, newName)"
                              Deleted="() => ConfirmDeleteColumn(column.Id, column.Name)" />

                <div class="task-list"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(column.Id)">
                    @for (var i = 0; i < GetFilteredTasks(column).Count; i++)
                    {
                        var task = GetFilteredTasks(column)[i];
                        var index = i;
                        <div class="drop-zone @(dragOverColumnId == column.Id && dragOverIndex == index ? "drop-zone-active" : "")"
                             ondragover="event.preventDefault();"
                             @ondragenter="() => SetDragOver(column.Id, index)"
                             @ondrop="() => HandleDropAt(column.Id, index)">
                            <TaskCard Task="task"
                                      LabelClass="@GetLabelClass(task.Id)"
                                      DragStarted="HandleDragStart"
                                      DeleteClicked="ConfirmDeleteTask"
                                      EditClicked="OpenEditModal"
                                      ArchiveClicked="ArchiveTask" />
                        </div>
                    }
                    @if (GetFilteredTasks(column).Count == 0)
                    {
                        <div class="empty-column">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                            </svg>
                            @if (!string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <span class="empty-text">Sin resultados para "@searchTerm"</span>
                            }
                            else
                            {
                                <span class="empty-text">Sin tareas aún</span>
                                <span class="empty-hint">Arrastra o crea una nueva</span>
                            }
                        </div>
                    }
                    <div class="drop-zone @(dragOverColumnId == column.Id && dragOverIndex == column.Tasks.Count ? "drop-zone-active" : "")"
                         ondragover="event.preventDefault();"
                         @ondragenter="() => SetDragOver(column.Id, column.Tasks.Count)"
                         @ondrop="() => HandleDropAt(column.Id, column.Tasks.Count)">
                    </div>
                </div>

                <button class="add-card-btn-inline" @onclick="() => OpenCreateModal(column.Id)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add a card
                </button>
            </div>
        }

        <AddColumnForm IsVisible="showAddColumn"
                       ToggleVisibility="() => showAddColumn = !showAddColumn"
                       SubmitColumn="CreateColumn" />
    </div>
}

<TaskDetailModal IsVisible="editModalVisible"
                Task="editingTask"
                CreatingInColumnId="creatingInColumnId"
                ColumnNames="columnNames"
                Cancel="CloseEditModal"
                Save="UpdateTask" />

<ConfirmModal IsVisible="confirmVisible"
              Title="@confirmTitle"
              Message="@confirmMessage"
              ConfirmText="@confirmConfirmText"
              Type="@confirmType"
              OnConfirm="ExecuteConfirmAction"
              OnCancel="CancelConfirm" />

<style>
    .toast-container {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 380px;
    }

    .toast {
        border-radius: 8px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        animation: slideInRight 0.25s ease-out;
        box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }

    .toast-error {
        background: #ffeceb;
        border: 1px solid #ff5630;
        color: #ae1e09;
    }

    .toast-success {
        background: #e3fcef;
        border: 1px solid #36b37e;
        color: #006644;
    }

    .toast-dismiss {
        margin-left: auto;
        background: none;
        border: none;
        cursor: pointer;
        padding: 2px;
        border-radius: 4px;
        display: flex;
        align-items: center;
    }

    .toast-dismiss:hover {
        background: rgba(0, 0, 0, 0.06);
    }

    .toast-success .toast-dismiss {
        color: #006644;
    }

    .toast-undo {
        margin-left: 8px;
        background: rgba(0, 102, 68, 0.1);
        border: 1px solid rgba(0, 102, 68, 0.3);
        color: #006644;
        padding: 2px 10px;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }

    .toast-undo:hover {
        background: rgba(0, 102, 68, 0.2);
    }

    .loading-board {
        color: white;
        text-align: center;
        margin-top: 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .spinner-mini {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .loading-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.75rem;
        font-weight: 400;
        margin-left: 8px;
    }

    .board-title-bar {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .board-section-title {
        color: white;
        font-weight: 700;
        font-size: 1rem;
        background: rgba(255,255,255,0.2);
        padding: 6px 14px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        margin-left: auto;
    }

    .search-icon {
        position: absolute;
        left: 10px;
        color: rgba(255, 255, 255, 0.6);
        pointer-events: none;
    }

    .search-input {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 6px;
        padding: 6px 30px 6px 30px;
        color: white;
        font-size: 0.85rem;
        outline: none;
        width: 200px;
        transition: background 0.15s, border-color 0.15s, width 0.2s;
    }

    .search-input::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    .search-input:focus {
        background: rgba(255, 255, 255, 0.3);
        border-color: rgba(255, 255, 255, 0.5);
        width: 260px;
    }

    .search-clear {
        position: absolute;
        right: 6px;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        padding: 2px;
        border-radius: 3px;
        display: flex;
        align-items: center;
    }

    .search-clear:hover {
        background: rgba(255, 255, 255, 0.15);
        color: white;
    }

    .shortcuts-help {
        position: relative;
        color: rgba(255,255,255,0.7);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background 0.15s, color 0.15s;
    }

    .shortcuts-help:hover {
        background: rgba(255,255,255,0.15);
        color: white;
    }

    .shortcuts-tooltip {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 6px;
        background: #1d2125;
        border-radius: 8px;
        padding: 10px 14px;
        min-width: 200px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.35);
        z-index: 100;
        color: #b6c2cf;
        font-size: 0.75rem;
        animation: fadeIn 0.15s ease-out;
    }

    .shortcuts-title {
        font-weight: 700;
        color: white;
        margin-bottom: 8px;
        font-size: 0.8rem;
    }

    .shortcut-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .shortcut-row kbd {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 4px;
        padding: 1px 6px;
        font-family: monospace;
        font-size: 0.7rem;
        color: white;
        min-width: 24px;
        text-align: center;
    }

    .kanban-board {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding-bottom: 16px;
    }

    .kanban-column {
        background: #f1f2f4;
        border-radius: 12px;
        width: 272px;
        min-width: 272px;
        padding: 8px;
        box-shadow: 0 1px 1px rgba(9, 30, 66, 0.25);
    }

    .task-list {
        min-height: 8px;
        margin-top: 4px;
    }

    .drop-zone {
        border-radius: 8px;
        transition: background 0.15s, border-color 0.15s;
        min-height: 4px;
    }

    .drop-zone-active {
        background: rgba(12, 102, 228, 0.12);
        border: 2px dashed #0c66e4;
        min-height: 40px;
    }

    .empty-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 12px;
        gap: 6px;
        color: rgba(255,255,255,0.5);
    }

    .empty-text {
        font-size: 0.8rem;
        font-weight: 500;
    }

    .empty-hint {
        font-size: 0.7rem;
        opacity: 0.6;
    }

    .kanban-board::-webkit-scrollbar {
        height: 8px;
    }

    .kanban-board::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.1);
        border-radius: 4px;
    }

    .kanban-board::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.3);
        border-radius: 4px;
    }

    .kanban-board::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.5);
    }

    .add-card-btn-inline {
        width: 100%;
        background: none;
        border: none;
        color: #626f86;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        transition: background 0.15s, color 0.15s;
    }

    .add-card-btn-inline:hover {
        background: rgba(9, 30, 66, 0.08);
        color: #172b4d;
    }

    @@media (max-width: 640px) {
        .kanban-board {
            gap: 10px;
            padding-bottom: 80px;
        }

        .kanban-column {
            width: 260px;
            min-width: 260px;
            padding: 6px;
        }

        .board-title-bar {
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .search-wrapper {
            width: 100%;
            order: 3;
        }

        .search-input,
        .search-input:focus {
            width: 100%;
        }

        .toast {
            font-size: 0.8rem;
            padding: 8px 10px;
        }

        .drop-zone-active {
            min-height: 32px;
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private List<ColumnItem>? columns;
    private Dictionary<int, bool> showAddCard = new();
    private int draggedTaskId;
    private string? errorMessage;
    private string? successMessage;
    private bool editModalVisible;
    private TaskItem? editingTask;
    private int? creatingInColumnId;
    private int dragOverColumnId;
    private int dragOverIndex;
    private bool showAddColumn;
    private bool isLoading;
    private string searchTerm = string.Empty;
    private Dictionary<int, string> columnNames = new();
    private UndoAction? lastAction;
    private CancellationTokenSource? undoTimerCts;
    private bool showShortcuts;
    private bool confirmVisible;
    private string confirmTitle = string.Empty;
    private string confirmMessage = string.Empty;
    private string confirmConfirmText = "Eliminar";
    private ConfirmModal.ConfirmType confirmType = ConfirmModal.ConfirmType.Danger;
    private Func<Task>? confirmAction;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoard();
        var dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("keyboardShortcuts.init", dotNetRef);
    }

    [JSInvokable]
    public async Task OnKeyDown(string key, bool ctrlKey, bool metaKey, bool isInput)
    {
        if (key == "Escape")
        {
            if (editModalVisible)
            {
                CloseEditModal();
                StateHasChanged();
            }
            return;
        }

        if (isInput) return;

        if ((ctrlKey || metaKey) && key == "z")
        {
            await Undo();
            return;
        }

        if (key == "n" || key == "N")
        {
            showAddColumn = true;
            StateHasChanged();
            return;
        }

        if ((key == "e" || key == "E") && columns != null)
        {
            var firstTask = columns.SelectMany(c => c.Tasks).FirstOrDefault();
            if (firstTask != null)
            {
                editingTask = firstTask;
                editModalVisible = true;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        undoTimerCts?.Cancel();
        undoTimerCts?.Dispose();
    }

    private async Task LoadBoard()
    {
        try
        {
            errorMessage = null;
            columns = await Kanban.GetBoardAsync();
            if (columns != null)
            {
                columnNames = columns.ToDictionary(c => c.Id, c => c.Name);
                foreach (var col in columns)
                {
                    if (!showAddCard.ContainsKey(col.Id))
                        showAddCard[col.Id] = false;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo conectar con el servidor: {ex.Message}";
        }
    }

    private string GetLabelClass(int taskId)
    {
        var labels = new[] { "label-yellow", "label-blue", "label-green", "label-pink", "label-purple", "label-orange" };
        return labels[taskId % labels.Length];
    }

    private List<TaskItem> GetFilteredTasks(ColumnItem column)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            return column.Tasks;

        var term = searchTerm.ToLowerInvariant();
        return column.Tasks
            .Where(t => t.Title.ToLowerInvariant().Contains(term)
                     || t.Description.ToLowerInvariant().Contains(term))
            .ToList();
    }

    private void ToggleAddCard(int columnId)
    {
        if (showAddCard.ContainsKey(columnId))
            showAddCard[columnId] = !showAddCard[columnId];
    }

    private void HandleDragStart(int taskId)
    {
        draggedTaskId = taskId;
    }

    private void SetDragOver(int columnId, int index)
    {
        dragOverColumnId = columnId;
        dragOverIndex = index;
    }

    private async Task HandleDrop(int targetColumnId)
    {
        if (draggedTaskId == 0) return;
        await HandleDropAt(targetColumnId, -1);
    }

    private async Task HandleDropAt(int targetColumnId, int targetIndex)
    {
        if (draggedTaskId == 0) return;

        try
        {
            if (columns == null) return;

            var draggedTask = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == draggedTaskId);
            if (draggedTask == null) return;

            var isSameColumn = draggedTask.ColumnId == targetColumnId;

            if (isSameColumn && targetIndex >= 0)
            {
                var currentIndex = columns.First(c => c.Id == targetColumnId)
                    .Tasks.FindIndex(t => t.Id == draggedTaskId);

                if (currentIndex == targetIndex || currentIndex == targetIndex - 1)
                {
                    draggedTaskId = 0;
                    dragOverColumnId = 0;
                    dragOverIndex = 0;
                    return;
                }

                var adjustedIndex = targetIndex > currentIndex ? targetIndex - 1 : targetIndex;

                var dto = new ReorderTaskDto
                {
                    TaskId = draggedTaskId,
                    TargetColumnId = targetColumnId,
                    NewOrder = adjustedIndex
                };
                await Kanban.ReorderTaskAsync(dto);
            }
            else
            {
                var originalColumnId = draggedTask.ColumnId;
                var moveDto = new MoveTaskDto { TaskId = draggedTaskId, TargetColumnId = targetColumnId };
                await Kanban.MoveTaskAsync(moveDto);

                SetUndo(new UndoAction
                {
                    Type = UndoType.Move,
                    TaskId = draggedTaskId,
                    ColumnId = originalColumnId
                });
            }

            draggedTaskId = 0;
            dragOverColumnId = 0;
            dragOverIndex = 0;
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al mover la tarea: {ex.Message}";
        }
    }

    private async Task CreateTask(int columnId, string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            var newTask = new TaskItem
            {
                Title = title,
                Description = "Nueva columna",
                ColumnId = columnId,
                Order = 1
            };

            var response = await Kanban.CreateTaskAsync(newTask);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al crear la tarea. Inténtalo de nuevo.";
                return;
            }

            showAddCard[columnId] = false;
            ShowSuccess("Tarea creada correctamente");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ArchiveTask(int taskId)
    {
        if (columns == null) return;
        var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (task == null) return;

        var completedColumn = columns.FirstOrDefault(c => c.Name == "Completado");
        if (completedColumn == null)
        {
            errorMessage = "No se encontró la columna 'Completado' para archivar.";
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            var originalColumnId = task.ColumnId;
            var dto = new MoveTaskDto { TaskId = taskId, TargetColumnId = completedColumn.Id };
            var response = await Kanban.MoveTaskAsync(dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al archivar la tarea.";
                return;
            }

            SetUndo(new UndoAction
            {
                Type = UndoType.Move,
                TaskId = taskId,
                ColumnId = originalColumnId
            });

            ShowSuccess("Tarea archivada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al archivar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteTask(int taskId)
    {
        if (columns == null) return;

        var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (task == null) return;

        confirmTitle = "Eliminar tarea";
        confirmMessage = $"¿Eliminar la tarea \"{task.Title}\"? Esta acción no se puede deshacer.";
        confirmConfirmText = "Eliminar";
        confirmType = ConfirmModal.ConfirmType.Danger;
        confirmAction = () => DeleteTask(taskId);
        confirmVisible = true;
        StateHasChanged();
    }

    private async Task DeleteTask(int taskId)
    {
        try
        {
            if (columns == null) return;
            var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
            if (task == null) return;

            var columnId = task.ColumnId;
            var order = task.Order;

            isLoading = true;
            StateHasChanged();

            var response = await Kanban.DeleteTaskAsync(taskId);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al eliminar la tarea. Inténtalo de nuevo.";
                return;
            }

            SetUndo(new UndoAction
            {
                Type = UndoType.Delete,
                TaskId = taskId,
                TaskData = task,
                ColumnId = columnId,
                Order = order
            });

            ShowSuccess("Tarea eliminada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenEditModal(int taskId)
    {
        if (columns == null) return;
        creatingInColumnId = null;
        editingTask = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (editingTask != null)
            editModalVisible = true;
    }

    private void OpenCreateModal(int columnId)
    {
        creatingInColumnId = columnId;
        editingTask = null;
        editModalVisible = true;
    }

    private void CloseEditModal()
    {
        editModalVisible = false;
        editingTask = null;
        creatingInColumnId = null;
    }

    private async Task UpdateTask(UpdateTaskDto dto)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            HttpResponseMessage response;

            if (editingTask != null)
            {
                response = await Kanban.UpdateTaskAsync(editingTask.Id, dto);
            }
            else if (creatingInColumnId.HasValue)
            {
                var newTask = new TaskItem
                {
                    Title = dto.Title,
                    Description = dto.Description,
                    ColumnId = creatingInColumnId.Value,
                    DueDate = dto.DueDate,
                    Labels = dto.Labels
                };
                response = await Kanban.CreateTaskAsync(newTask);
            }
            else
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al guardar la tarea. Inténtalo de nuevo.";
                return;
            }

            CloseEditModal();
            ShowSuccess(editingTask != null ? "Tarea actualizada" : "Tarea creada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

