@page "/"
@inject IJSRuntime JSRuntime
@inject KanbanService Kanban
@using task_board_client.Models
@using task_board_client.Services
@using task_board_client.Components
@implements IDisposable

<PageTitle>Tablero Kanban</PageTitle>

<div class="toast-container">
    @if (errorMessage != null)
    {
        <div class="toast toast-error">
            <div class="toast-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div class="toast-body">
                <div class="toast-title">Error</div>
                <div class="toast-message">@errorMessage</div>
            </div>
            <button class="toast-dismiss" @onclick="() => errorMessage = null">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }

    @if (successMessage != null)
    {
        <div class="toast toast-success">
            <div class="toast-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <div class="toast-body">
                <div class="toast-title">Éxito</div>
                <div class="toast-message">
                    @successMessage
                    @if (lastAction != null)
                    {
                        <span class="toast-hint"> — Presiona <kbd>Ctrl+Z</kbd> para deshacer</span>
                    }
                </div>
            </div>
            @if (lastAction != null)
            {
                <button class="toast-undo" @onclick="Undo">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                    Deshacer
                </button>
            }
            <button class="toast-dismiss" @onclick="() => successMessage = null">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }
</div>

@if (isLoading && columns == null)
{
    <div class="loading-board">
        <div class="spinner"></div>
        <p>Cargando tablero...</p>
    </div>
}
else if (columns != null)
{
<div class="board-page">
    <div class="board-title-bar">
        <HamburgerMenu Columns="columns"
                       ViewChanged="OnViewChanged"
                       OnNewBoardRequested="OnNewBoard"
                       OnSettingsRequested="OnSettings"
                       OnExportRequested="OnExport"
                       OnManageLabelsRequested="OnManageLabels" />
        <span class="board-section-title">Board</span>
        @if (isLoading)
        {
            <span class="loading-indicator">
                <div class="spinner-mini"></div>
                Guardando...
            </span>
        }
        <div class="shortcuts-help" @onclick="ToggleShortcutsHelp" data-tooltip="Atajos de teclado">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
                <path d="M6 8h.001"></path><path d="M10 8h.001"></path><path d="M14 8h.001"></path>
                <path d="M8 12h.001"></path><path d="M12 12h.001"></path><path d="M16 12h.001"></path>
                <path d="M7 16h10"></path>
            </svg>
            @if (showShortcuts)
            {
                <div class="shortcuts-tooltip">
                    <div class="shortcuts-title">Atajos de teclado</div>
                    <div class="shortcut-row"><kbd>N</kbd> Nueva columna</div>
                    <div class="shortcut-row"><kbd>E</kbd> Editar primera tarea</div>
                    <div class="shortcut-row"><kbd>Ctrl+Z</kbd> Deshacer</div>
                    <div class="shortcut-row"><kbd>Esc</kbd> Cerrar modal</div>
                </div>
            }
        </div>
        <div class="filter-toggle @(showFilters ? "active" : "")" @onclick="() => showFilters = !showFilters" data-tooltip="Filtros y búsqueda">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            @if (HasActiveFilters)
            {
                <span class="filter-badge"></span>
            }
        </div>
    </div>

    @if (showFilters)
    {
        <div class="filters-panel">
            <div class="filter-group filter-search-group">
                <label class="filter-label">Buscar</label>
                <div class="search-wrapper">
                    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text"
                           class="search-input"
                           @bind="searchTerm"
                           @bind:event="oninput"
                           placeholder="Buscar tareas..." />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="search-clear" @onclick="() => searchTerm = string.Empty" data-tooltip="Limpiar búsqueda">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>
            </div>
            <div class="filter-group">
                <label class="filter-label">Etiqueta</label>
                <div class="filter-chips">
                    @foreach (var label in allLabels)
                    {
                        <button class="filter-chip @(filterLabels.Contains(label) ? "active" : "")"
                                @onclick="() => ToggleFilterLabel(label)">
                            <span class="label-dot-sm" style="background: @GetLabelColor(label)"></span>
                            @label
                        </button>
                    }
                </div>
            </div>
            <div class="filter-group">
                <label class="filter-label">Fecha</label>
                <div class="filter-chips">
                    <button class="filter-chip @(filterDate == "overdue" ? "active" : "")" @onclick='() => SetFilterDate("overdue")'>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                        Vencida
                    </button>
                    <button class="filter-chip @(filterDate == "today" ? "active" : "")" @onclick='() => SetFilterDate("today")'>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Vence hoy
                    </button>
                    <button class="filter-chip @(filterDate == "upcoming" ? "active" : "")" @onclick='() => SetFilterDate("upcoming")'>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Próximamente
                    </button>
                    <button class="filter-chip @(filterDate == "none" ? "active" : "")" @onclick='() => SetFilterDate("none")'>
                        Sin fecha
                    </button>
                </div>
            </div>
            @if (HasActiveFilters)
            {
                <button class="filter-clear-all" @onclick="ClearFilters">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Limpiar filtros
                </button>
            }
        </div>
    }

    <div class="kanban-board">
        @foreach (var column in columns)
        {
            <div class="kanban-column">

                <ColumnHeader Title="@column.Name"
                              Renamed="(newName) => RenameColumn(column.Id, newName)"
                              Deleted="() => ConfirmDeleteColumn(column.Id, column.Name)" />

                <div class="task-list"
                     ondragover="event.preventDefault();"
                     @ondrop="() => HandleDrop(column.Id)">
                    @for (var i = 0; i < GetFilteredTasks(column).Count; i++)
                    {
                        var task = GetFilteredTasks(column)[i];
                        var index = i;
                        <div class="drop-zone @(dragOverColumnId == column.Id && dragOverIndex == index ? "drop-zone-active" : "")"
                             ondragover="event.preventDefault();"
                             @ondragenter="() => SetDragOver(column.Id, index)"
                             @ondrop="() => HandleDropAt(column.Id, index)">
                            <TaskCard Task="task"
                                      LabelClass="@GetLabelClass(task.Id)"
                                      DragStarted="HandleDragStart"
                                      DeleteClicked="ConfirmDeleteTask"
                                      EditClicked="OpenEditModal" />
                        </div>
                    }
                    @if (GetFilteredTasks(column).Count == 0)
                    {
                        <div class="empty-column">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.4">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                            </svg>
                            @if (!string.IsNullOrWhiteSpace(searchTerm))
                            {
                                <span class="empty-text">Sin resultados para "@searchTerm"</span>
                            }
                            else
                            {
                                <span class="empty-text">Sin tareas aún</span>
                                <span class="empty-hint">Arrastra o crea una nueva</span>
                            }
                        </div>
                    }
                    <div class="drop-zone @(dragOverColumnId == column.Id && dragOverIndex == column.Tasks.Count ? "drop-zone-active" : "")"
                         ondragover="event.preventDefault();"
                         @ondragenter="() => SetDragOver(column.Id, column.Tasks.Count)"
                         @ondrop="() => HandleDropAt(column.Id, column.Tasks.Count)">
                    </div>
                </div>

                <button class="add-card-btn-inline" @onclick="() => OpenCreateModal(column.Id)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add a card
                </button>
            </div>
        }

        <AddColumnForm IsVisible="showAddColumn"
                       ToggleVisibility="() => showAddColumn = !showAddColumn"
                       SubmitColumn="CreateColumn" />
    </div>
</div>
}

<TaskDetailModal IsVisible="editModalVisible"
                Task="editingTask"
                CreatingInColumnId="creatingInColumnId"
                ColumnNames="columnNames"
                Cancel="CloseEditModal"
                Save="UpdateTask" />

<ConfirmModal IsVisible="confirmVisible"
              Title="@confirmTitle"
              Message="@confirmMessage"
              ConfirmText="@confirmConfirmText"
              Type="@confirmType"
              OnConfirm="ExecuteConfirmAction"
              OnCancel="CancelConfirm" />

<style>
    .board-page {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        padding: 16px;
    }

    .toast-container {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 400px;
    }

    .toast {
        border-radius: 10px;
        padding: 12px 14px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        animation: slideInRight 0.25s ease-out;
        box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    }

    .toast-icon {
        flex-shrink: 0;
        margin-top: 1px;
    }

    .toast-body {
        flex: 1;
        min-width: 0;
    }

    .toast-title {
        font-weight: 700;
        font-size: 0.82rem;
        margin-bottom: 2px;
    }

    .toast-message {
        font-size: 0.78rem;
        line-height: 1.4;
        opacity: 0.85;
    }

    .toast-hint {
        font-size: 0.73rem;
        opacity: 0.7;
    }

    .toast-hint kbd {
        background: rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.15);
        border-radius: 3px;
        padding: 0 4px;
        font-family: monospace;
        font-size: 0.7rem;
    }

    .toast-error {
        background: #ffeceb;
        border: 1px solid #ff5630;
        color: #ae1e09;
    }

    .toast-success {
        background: #e3fcef;
        border: 1px solid #36b37e;
        color: #006644;
    }

    .toast-dismiss {
        background: none;
        border: none;
        cursor: pointer;
        padding: 2px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        flex-shrink: 0;
        opacity: 0.5;
    }

    .toast-dismiss:hover {
        opacity: 1;
        background: rgba(0, 0, 0, 0.06);
    }

    .toast-undo {
        background: rgba(0, 102, 68, 0.12);
        border: 1px solid rgba(0, 102, 68, 0.3);
        color: #006644;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
        margin-top: 4px;
    }

    .toast-undo:hover {
        background: rgba(0, 102, 68, 0.2);
    }

    .loading-board {
        color: white;
        text-align: center;
        margin-top: 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .spinner-mini {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .loading-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.75rem;
        font-weight: 400;
        margin-left: 8px;
    }

    .board-title-bar {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .board-section-title {
        color: white;
        font-weight: 700;
        font-size: 1rem;
        background: rgba(255,255,255,0.2);
        padding: 6px 14px;
        border-radius: 4px;
        white-space: nowrap;
    }

    .filter-search-group {
        flex: 0 0 auto;
        width: 220px;
    }

    .search-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 10px;
        color: #626f86;
        pointer-events: none;
    }

    .search-input {
        background: white;
        border: 1px solid #d0d4dc;
        border-radius: 6px;
        padding: 5px 28px 5px 28px;
        color: #172b4d;
        font-size: 0.8rem;
        outline: none;
        width: 100%;
        height: 30px;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .search-input::placeholder {
        color: #8993a4;
    }

    .search-input:focus {
        border-color: #0c66e4;
        box-shadow: 0 0 0 1px #0c66e4;
    }

    .search-clear {
        position: absolute;
        right: 6px;
        background: none;
        border: none;
        color: #626f86;
        cursor: pointer;
        padding: 2px;
        border-radius: 3px;
        display: flex;
        align-items: center;
    }

    .search-clear:hover {
        background: #f1f2f4;
        color: #172b4d;
    }

    .shortcuts-help {
        position: relative;
        margin-left: auto;
        color: rgba(255,255,255,0.7);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background 0.15s, color 0.15s;
    }

    .shortcuts-help:hover {
        background: rgba(255,255,255,0.15);
        color: white;
    }

    .shortcuts-tooltip {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 6px;
        background: #1d2125;
        border-radius: 8px;
        padding: 10px 14px;
        min-width: 200px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.35);
        z-index: 100;
        color: #b6c2cf;
        font-size: 0.75rem;
        animation: fadeIn 0.15s ease-out;
    }

    .shortcuts-title {
        font-weight: 700;
        color: white;
        margin-bottom: 8px;
        font-size: 0.8rem;
    }

    .shortcut-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .shortcut-row kbd {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 4px;
        padding: 1px 6px;
        font-family: monospace;
        font-size: 0.7rem;
        color: white;
        min-width: 24px;
        text-align: center;
    }

    .filter-toggle {
        position: relative;
        color: rgba(255,255,255,0.7);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background 0.15s, color 0.15s;
    }

    .filter-toggle:hover, .filter-toggle.active {
        background: rgba(255,255,255,0.15);
        color: white;
    }

    .filter-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 7px;
        height: 7px;
        background: #ff991f;
        border-radius: 50%;
        border: 1.5px solid #0c66e4;
    }

    .filters-panel {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 12px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
        animation: fadeIn 0.15s ease-out;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-label {
        color: rgba(255,255,255,0.8);
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .filter-chip {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 0 8px;
        height: 30px;
        border-radius: 4px;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.8);
        font-size: 0.72rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .filter-chip:hover {
        background: rgba(255,255,255,0.18);
    }

    .filter-chip.active {
        background: rgba(255,255,255,0.25);
        border-color: rgba(255,255,255,0.5);
        color: white;
        font-weight: 600;
    }

    .label-dot-sm {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .filter-clear-all {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 0 10px;
        height: 30px;
        border-radius: 4px;
        border: none;
        background: rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.8);
        font-size: 0.72rem;
        cursor: pointer;
        transition: background 0.15s;
        align-self: flex-end;
    }

    .filter-clear-all:hover {
        background: rgba(255,255,255,0.22);
    }

    .kanban-board {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding-bottom: 16px;
        flex-wrap: wrap;
    }

    .kanban-column {
        background: #f1f2f4;
        border-radius: 12px;
        width: 272px;
        min-width: 272px;
        padding: 8px;
        box-shadow: 0 1px 1px rgba(9, 30, 66, 0.25);
    }

    .task-list {
        min-height: 8px;
        margin-top: 4px;
        padding-right: 2px;
    }

    .drop-zone {
        border-radius: 8px;
        transition: background 0.15s, border-color 0.15s;
        min-height: 4px;
    }

    .drop-zone-active {
        background: rgba(12, 102, 228, 0.12);
        border: 2px dashed #0c66e4;
        min-height: 40px;
    }

    .empty-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px 12px;
        gap: 6px;
        color: rgba(255,255,255,0.5);
    }

    .empty-text {
        font-size: 0.8rem;
        font-weight: 500;
    }

    .empty-hint {
        font-size: 0.7rem;
        opacity: 0.6;
    }

    .add-card-btn-inline {
        width: 100%;
        background: none;
        border: none;
        color: #626f86;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        transition: background 0.15s, color 0.15s;
    }

    .add-card-btn-inline:hover {
        background: rgba(9, 30, 66, 0.08);
        color: #172b4d;
    }

    @@media (max-width: 640px) {
        .kanban-board {
            gap: 10px;
            padding-bottom: 80px;
        }

        .kanban-column {
            width: 260px;
            min-width: 260px;
            padding: 6px;
        }

        .board-title-bar {
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .search-wrapper {
            width: 100%;
            order: 3;
        }

        .search-input,
        .search-input:focus {
            width: 100%;
        }

        .toast {
            font-size: 0.8rem;
            padding: 8px 10px;
        }

        .drop-zone-active {
            min-height: 32px;
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private List<ColumnItem>? columns;
    private Dictionary<int, bool> showAddCard = new();
    private int draggedTaskId;
    private string? errorMessage;
    private string? successMessage;
    private bool editModalVisible;
    private TaskItem? editingTask;
    private int? creatingInColumnId;
    private int dragOverColumnId;
    private int dragOverIndex;
    private bool showAddColumn;
    private bool isLoading;
    private string searchTerm = string.Empty;
    private Dictionary<int, string> columnNames = new();
    private UndoAction? lastAction;
    private CancellationTokenSource? undoTimerCts;
    private bool showShortcuts;
    private bool confirmVisible;
    private string confirmTitle = string.Empty;
    private string confirmMessage = string.Empty;
    private string confirmConfirmText = "Eliminar";
    private ConfirmModal.ConfirmType confirmType = ConfirmModal.ConfirmType.Danger;
    private Func<Task>? confirmAction;
    private bool showFilters;
    private HashSet<string> filterLabels = new();
    private string? filterDate;
    private readonly string[] allLabels = { "Alta", "Media", "Baja", "Bug", "Feature", "Mejora", "Urgente", "Diseño" };
    private string currentView = "board";
    private bool labelModalVisible;

    private bool HasActiveFilters => filterLabels.Count > 0 || filterDate != null;

    [JSInvokable]
    public async Task OnKeyDown(string key, bool ctrlKey, bool metaKey, bool isInput)
    {
        if (key == "Escape")
        {
            if (editModalVisible)
            {
                CloseEditModal();
                StateHasChanged();
            }
            else if (confirmVisible)
            {
                CancelConfirm();
            }
            else if (showFilters)
            {
                showFilters = false;
                StateHasChanged();
            }
            return;
        }

        if (isInput) return;

        if ((ctrlKey || metaKey) && key == "z")
        {
            await Undo();
            return;
        }

        if (key == "n" || key == "N")
        {
            showAddColumn = true;
            StateHasChanged();
            return;
        }

        if ((key == "e" || key == "E") && columns != null)
        {
            var firstTask = columns.SelectMany(c => c.Tasks).FirstOrDefault();
            if (firstTask != null)
            {
                editingTask = firstTask;
                editModalVisible = true;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        undoTimerCts?.Cancel();
        undoTimerCts?.Dispose();
    }

    private async Task LoadBoard()
    {
        try
        {
            errorMessage = null;
            columns = await Kanban.GetBoardAsync();
            if (columns != null)
            {
                columnNames = columns.ToDictionary(c => c.Id, c => c.Name);
                foreach (var col in columns)
                {
                    if (!showAddCard.ContainsKey(col.Id))
                        showAddCard[col.Id] = false;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo conectar con el servidor: {ex.Message}";
        }
    }

    private string GetLabelClass(int taskId)
    {
        var labels = new[] { "label-yellow", "label-blue", "label-green", "label-pink", "label-purple", "label-orange" };
        return labels[taskId % labels.Length];
    }

    private List<TaskItem> GetFilteredTasks(ColumnItem column)
    {
        var tasks = column.Tasks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLowerInvariant();
            tasks = tasks.Where(t => t.Title.ToLowerInvariant().Contains(term)
                                  || t.Description.ToLowerInvariant().Contains(term));
        }

        if (filterLabels.Count > 0)
        {
            tasks = tasks.Where(t => !string.IsNullOrWhiteSpace(t.Labels)
                && t.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Any(l => filterLabels.Contains(l.Trim())));
        }

        if (filterDate != null)
        {
            tasks = filterDate switch
            {
                "overdue" => tasks.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today),
                "today" => tasks.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date == DateTime.Today),
                "upcoming" => tasks.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date > DateTime.Today),
                "none" => tasks.Where(t => !t.DueDate.HasValue),
                _ => tasks
            };
        }

        return tasks.ToList();
    }

    private void ToggleAddCard(int columnId)
    {
        if (showAddCard.ContainsKey(columnId))
            showAddCard[columnId] = !showAddCard[columnId];
    }

    private void HandleDragStart(int taskId)
    {
        draggedTaskId = taskId;
    }

    private void SetDragOver(int columnId, int index)
    {
        dragOverColumnId = columnId;
        dragOverIndex = index;
    }

    private async Task HandleDrop(int targetColumnId)
    {
        if (draggedTaskId == 0) return;
        await HandleDropAt(targetColumnId, -1);
    }

    private async Task HandleDropAt(int targetColumnId, int targetIndex)
    {
        if (draggedTaskId == 0) return;

        try
        {
            if (columns == null) return;

            var draggedTask = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == draggedTaskId);
            if (draggedTask == null) return;

            var isSameColumn = draggedTask.ColumnId == targetColumnId;

            if (isSameColumn && targetIndex >= 0)
            {
                var currentIndex = columns.First(c => c.Id == targetColumnId)
                    .Tasks.FindIndex(t => t.Id == draggedTaskId);

                if (currentIndex == targetIndex || currentIndex == targetIndex - 1)
                {
                    draggedTaskId = 0;
                    dragOverColumnId = 0;
                    dragOverIndex = 0;
                    return;
                }

                var adjustedIndex = targetIndex > currentIndex ? targetIndex - 1 : targetIndex;

                var dto = new ReorderTaskDto
                {
                    TaskId = draggedTaskId,
                    TargetColumnId = targetColumnId,
                    NewOrder = adjustedIndex
                };
                await Kanban.ReorderTaskAsync(dto);
            }
            else
            {
                var originalColumnId = draggedTask.ColumnId;
                var moveDto = new MoveTaskDto { TaskId = draggedTaskId, TargetColumnId = targetColumnId };
                await Kanban.MoveTaskAsync(moveDto);

                SetUndo(new UndoAction
                {
                    Type = UndoType.Move,
                    TaskId = draggedTaskId,
                    ColumnId = originalColumnId
                });
            }

            draggedTaskId = 0;
            dragOverColumnId = 0;
            dragOverIndex = 0;
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al mover la tarea: {ex.Message}";
        }
    }

    private async Task CreateTask(int columnId, string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            var newTask = new TaskItem
            {
                Title = title,
                Description = "Nueva columna",
                ColumnId = columnId,
                Order = 1
            };

            var response = await Kanban.CreateTaskAsync(newTask);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al crear la tarea. Inténtalo de nuevo.";
                return;
            }

            showAddCard[columnId] = false;
            ShowSuccess("Tarea creada correctamente");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteTask(int taskId)
    {
        if (columns == null) return;

        var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (task == null) return;

        confirmTitle = "Eliminar tarea";
        confirmMessage = $"¿Eliminar la tarea \"{task.Title}\"? Esta acción no se puede deshacer.";
        confirmConfirmText = "Eliminar";
        confirmType = ConfirmModal.ConfirmType.Danger;
        confirmAction = () => DeleteTask(taskId);
        confirmVisible = true;
        StateHasChanged();
    }

    private async Task DeleteTask(int taskId)
    {
        try
        {
            if (columns == null) return;
            var task = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
            if (task == null) return;

            var columnId = task.ColumnId;
            var order = task.Order;

            isLoading = true;
            StateHasChanged();

            var response = await Kanban.DeleteTaskAsync(taskId);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al eliminar la tarea. Inténtalo de nuevo.";
                return;
            }

            SetUndo(new UndoAction
            {
                Type = UndoType.Delete,
                TaskId = taskId,
                TaskData = task,
                ColumnId = columnId,
                Order = order
            });

            ShowSuccess("Tarea eliminada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenEditModal(int taskId)
    {
        if (columns == null) return;
        creatingInColumnId = null;
        editingTask = columns.SelectMany(c => c.Tasks).FirstOrDefault(t => t.Id == taskId);
        if (editingTask != null)
            editModalVisible = true;
    }

    private void OpenCreateModal(int columnId)
    {
        creatingInColumnId = columnId;
        editingTask = null;
        editModalVisible = true;
    }

    private void CloseEditModal()
    {
        editModalVisible = false;
        editingTask = null;
        creatingInColumnId = null;
    }

    private async Task UpdateTask(UpdateTaskDto dto)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            HttpResponseMessage response;

            if (editingTask != null)
            {
                response = await Kanban.UpdateTaskAsync(editingTask.Id, dto);
            }
            else if (creatingInColumnId.HasValue)
            {
                var newTask = new TaskItem
                {
                    Title = dto.Title,
                    Description = dto.Description,
                    ColumnId = creatingInColumnId.Value,
                    DueDate = dto.DueDate,
                    Labels = dto.Labels
                };
                response = await Kanban.CreateTaskAsync(newTask);
            }
            else
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al guardar la tarea. Inténtalo de nuevo.";
                return;
            }

            CloseEditModal();
            ShowSuccess(editingTask != null ? "Tarea actualizada" : "Tarea creada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar la tarea: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateColumn(string name)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new CreateColumnDto { Name = name };
            var response = await Kanban.CreateColumnAsync(dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al crear la columna. Inténtalo de nuevo.";
                return;
            }

            showAddColumn = false;
            ShowSuccess("Columna creada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear la columna: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RenameColumn(int columnId, string newName)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var dto = new UpdateColumnDto { Name = newName };
            var response = await Kanban.UpdateColumnAsync(columnId, dto);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al renombrar la columna. Inténtalo de nuevo.";
                return;
            }

            ShowSuccess("Columna renombrada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al renombrar la columna: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteColumn(int columnId, string columnName)
    {
        if (columns == null) return;

        var column = columns.FirstOrDefault(c => c.Id == columnId);
        var taskCount = column?.Tasks.Count ?? 0;

        confirmTitle = "Eliminar columna";
        confirmMessage = taskCount > 0
            ? $"¿Eliminar la columna \"{columnName}\" y sus {taskCount} tarea(s)? Esta acción no se puede deshacer."
            : $"¿Eliminar la columna \"{columnName}\"? Esta acción no se puede deshacer.";
        confirmConfirmText = "Eliminar columna";
        confirmType = ConfirmModal.ConfirmType.Danger;
        confirmAction = () => DeleteColumn(columnId);
        confirmVisible = true;
        StateHasChanged();
    }

    private async Task DeleteColumn(int columnId)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await Kanban.DeleteColumnAsync(columnId);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Error al eliminar la columna. Inténtalo de nuevo.";
                return;
            }

            ShowSuccess("Columna eliminada");
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la columna: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteConfirmAction()
    {
        confirmVisible = false;
        StateHasChanged();
        if (confirmAction != null)
        {
            await confirmAction.Invoke();
            confirmAction = null;
        }
    }

    private void CancelConfirm()
    {
        confirmVisible = false;
        confirmAction = null;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBoard();
        var dotNetRef = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("keyboardShortcuts.init", dotNetRef);
    }

    private void ToggleFilterLabel(string label)
    {
        if (filterLabels.Contains(label))
            filterLabels.Remove(label);
        else
            filterLabels.Add(label);
    }

    private void SetFilterDate(string? dateFilter)
    {
        filterDate = filterDate == dateFilter ? null : dateFilter;
    }

    private void ClearFilters()
    {
        filterLabels.Clear();
        filterDate = null;
    }

    private string GetLabelColor(string label)
    {
        return label.Trim() switch
        {
            "Alta" => "#ff5630",
            "Media" => "#ff991f",
            "Baja" => "#36b37e",
            "Bug" => "#ff5630",
            "Feature" => "#579dff",
            "Mejora" => "#9f8fef",
            "Urgente" => "#e8916d",
            "Diseño" => "#f472b6",
            _ => "#626f86"
        };
    }

    private void ToggleShortcutsHelp()
    {
        showShortcuts = !showShortcuts;
        StateHasChanged();
    }

    private void ShowSuccess(string message)
    {
        _ = ShowSuccessInternal(message);
    }

    private async Task ShowSuccessInternal(string message)
    {
        successMessage = message;
        StateHasChanged();
        await Task.Delay(2500);
        successMessage = null;
        StateHasChanged();
    }

    private void SetUndo(UndoAction action)
    {
        undoTimerCts?.Cancel();
        undoTimerCts?.Dispose();
        undoTimerCts = new CancellationTokenSource();
        lastAction = action;

        _ = AutoClearUndo(undoTimerCts.Token);
    }

    private async Task AutoClearUndo(CancellationToken ct)
    {
        try
        {
            await Task.Delay(10000, ct);
            lastAction = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task Undo()
    {
        if (lastAction == null) return;

        try
        {
            isLoading = true;
            StateHasChanged();

            switch (lastAction.Type)
            {
                case UndoType.Delete:
                    var restoredTask = new TaskItem
                    {
                        Title = lastAction.TaskData!.Title,
                        Description = lastAction.TaskData.Description,
                        ColumnId = lastAction.ColumnId,
                        Order = lastAction.Order,
                        DueDate = lastAction.TaskData.DueDate,
                        Labels = lastAction.TaskData.Labels
                    };
                    await Kanban.CreateTaskAsync(restoredTask);
                    ShowSuccess("Acción deshecha");
                    break;

                case UndoType.Move:
                    var moveBack = new MoveTaskDto
                    {
                        TaskId = lastAction.TaskId,
                        TargetColumnId = lastAction.ColumnId
                    };
                    await Kanban.MoveTaskAsync(moveBack);
                    ShowSuccess("Acción deshecha");
                    break;
            }

            lastAction = null;
            await LoadBoard();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al deshacer: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class UndoAction
    {
        public UndoType Type { get; set; }
        public int TaskId { get; set; }
        public TaskItem? TaskData { get; set; }
        public int ColumnId { get; set; }
        public int Order { get; set; }
    }

    private enum UndoType
    {
        Delete,
        Move
    }

    private async Task OnViewChanged(string view)
    {
        currentView = view;
        StateHasChanged();
    }

    private async Task OnNewBoard()
    {
        showAddColumn = true;
        StateHasChanged();
    }

    private async Task OnSettings()
    {
    }

    private async Task OnExport()
    {
        if (columns == null) return;

        var exportData = new
        {
            board = "Task Board",
            exportedAt = DateTime.Now,
            columns = columns.Select(c => new
            {
                name = c.Name,
                order = c.Order,
                tasks = c.Tasks.Select(t => new
                {
                    title = t.Title,
                    description = t.Description,
                    labels = t.Labels,
                    dueDate = t.DueDate?.ToString("yyyy-MM-dd"),
                    order = t.Order
                })
            })
        };

        var json = System.Text.Json.JsonSerializer.Serialize(exportData, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
        ShowSuccess("Tablero copiado al portapapeles como JSON");
    }

    private void OnManageLabels()
    {
        labelModalVisible = true;
        StateHasChanged();
    }
}
