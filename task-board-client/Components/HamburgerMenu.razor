@using task_board_client.Models

<div class="hamburger-btn" @onclick="ToggleMenu" data-tooltip="Menú">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
</div>

@if (isOpen)
{
    <div class="hamburger-overlay" @onclick="CloseMenu"></div>
    <div class="hamburger-panel">
        <div class="hamburger-header">
            <span class="hamburger-logo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
                Task Board
            </span>
            <button class="hamburger-close" @onclick="CloseMenu">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="hamburger-section">
            <div class="hamburger-section-title">Esenciales</div>
            <button class="hamburger-item" @onclick="OnNewBoard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nuevo tablero
            </button>
            <button class="hamburger-item" @onclick="OnSettings">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                Configuración
            </button>
            <button class="hamburger-item" @onclick="OnExport">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Exportar tablero
            </button>
        </div>

        <div class="hamburger-section">
            <div class="hamburger-section-title">Utilidades</div>
            <div class="hamburger-item-group">
                <span class="hamburger-item-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                    </svg>
                    Cambiar vista
                </span>
                <div class="hamburger-view-options">
                    <button class="hamburger-view-btn @(currentView == "board" ? "active" : "")" @onclick='() => SetView("board")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="5" height="18" rx="1"></rect>
                            <rect x="10" y="3" width="5" height="12" rx="1"></rect>
                            <rect x="17" y="3" width="5" height="15" rx="1"></rect>
                        </svg>
                        Tablero
                    </button>
                    <button class="hamburger-view-btn @(currentView == "list" ? "active" : "")" @onclick='() => SetView("list")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                        Lista
                    </button>
                    <button class="hamburger-view-btn @(currentView == "calendar" ? "active" : "")" @onclick='() => SetView("calendar")'>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Calendario
                    </button>
                </div>
            </div>
            <button class="hamburger-item" @onclick="ToggleFilters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                Filtros y búsqueda
                @if (HasActiveFilters)
                {
                    <span class="hamburger-badge"></span>
                }
            </button>
            <button class="hamburger-item" @onclick="OnManageLabels">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                    <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
                Administrar etiquetas
            </button>
        </div>

        <div class="hamburger-divider"></div>

        <div class="hamburger-section">
            <div class="hamburger-shortcuts">
                <div class="hamburger-shortcuts-title">Atajos de teclado</div>
                <div class="hamburger-shortcut-row"><kbd>N</kbd> Nueva columna</div>
                <div class="hamburger-shortcut-row"><kbd>E</kbd> Editar primera tarea</div>
                <div class="hamburger-shortcut-row"><kbd>Ctrl+Z</kbd> Deshacer</div>
                <div class="hamburger-shortcut-row"><kbd>Esc</kbd> Cerrar modal</div>
            </div>
        </div>

        <div class="hamburger-divider"></div>

        <div class="hamburger-section">
            <div class="hamburger-item-group">
                <span class="hamburger-item-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    Mi perfil
                </span>
                <span class="hamburger-user-name">Edinson</span>
            </div>
            <button class="hamburger-item hamburger-item-danger" @onclick="OnLogout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Cerrar sesión
            </button>
        </div>
    </div>
}

<style>
    .hamburger-btn {
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #44546f;
        transition: background 0.15s;
    }

    .hamburger-btn:hover {
        background: #e4e7eb;
    }

    .hamburger-overlay {
        position: fixed;
        inset: 0;
        z-index: 9000;
        background: rgba(0, 0, 0, 0.4);
        animation: fadeIn 0.15s ease-out;
    }

    .hamburger-panel {
        position: fixed;
        top: 0;
        left: 0;
        width: 280px;
        height: 100%;
        background: #f7f8f9;
        z-index: 9500;
        display: flex;
        flex-direction: column;
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);
        animation: slideInLeft 0.2s ease-out;
        overflow-y: auto;
    }

    .hamburger-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 16px 12px;
        border-bottom: 1px solid #dfe1e6;
    }

    .hamburger-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 1rem;
        color: #172b4d;
    }

    .hamburger-close {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        color: #626f86;
        display: flex;
        align-items: center;
        transition: background 0.15s;
    }

    .hamburger-close:hover {
        background: #dfe1e6;
    }

    .hamburger-section {
        padding: 8px 12px;
    }

    .hamburger-section-title {
        font-size: 0.7rem;
        font-weight: 600;
        color: #626f86;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 8px;
        margin-bottom: 2px;
    }

    .hamburger-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border: none;
        background: none;
        color: #172b4d;
        font-size: 0.85rem;
        cursor: pointer;
        border-radius: 6px;
        text-align: left;
        transition: background 0.1s;
    }

    .hamburger-item:hover {
        background: #e4e7eb;
    }

    .hamburger-item svg {
        color: #626f86;
        flex-shrink: 0;
    }

    .hamburger-item-danger {
        color: #ae1e09;
    }

    .hamburger-item-danger svg {
        color: #ae1e09;
    }

    .hamburger-item-danger:hover {
        background: #ffeceb;
    }

    .hamburger-item-group {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        border-radius: 6px;
    }

    .hamburger-item-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        color: #172b4d;
    }

    .hamburger-item-label svg {
        color: #626f86;
    }

    .hamburger-user-name {
        font-size: 0.8rem;
        color: #626f86;
    }

    .hamburger-view-options {
        display: flex;
        gap: 4px;
        background: #dfe1e6;
        border-radius: 6px;
        padding: 3px;
    }

    .hamburger-view-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border: none;
        background: none;
        color: #626f86;
        font-size: 0.75rem;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.15s;
        white-space: nowrap;
    }

    .hamburger-view-btn.active {
        background: white;
        color: #172b4d;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .hamburger-view-btn:hover:not(.active) {
        color: #172b4d;
    }

    .hamburger-divider {
        height: 1px;
        background: #dfe1e6;
        margin: 4px 12px;
    }

    .hamburger-badge {
        width: 8px;
        height: 8px;
        background: #ff991f;
        border-radius: 50%;
        margin-left: auto;
    }

    .hamburger-shortcuts {
        padding: 4px 10px;
    }

    .hamburger-shortcuts-title {
        font-size: 0.7rem;
        font-weight: 600;
        color: #626f86;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .hamburger-shortcut-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 0.8rem;
        color: #44546f;
    }

    .hamburger-shortcut-row kbd {
        background: #e4e7eb;
        border: 1px solid #d0d4dc;
        border-radius: 4px;
        padding: 1px 6px;
        font-family: monospace;
        font-size: 0.7rem;
        color: #172b4d;
        min-width: 24px;
        text-align: center;
    }
</style>

@code {
    [Parameter] public List<ColumnItem>? Columns { get; set; }
    [Parameter] public EventCallback<string> ViewChanged { get; set; }
    [Parameter] public EventCallback OnNewBoardRequested { get; set; }
    [Parameter] public EventCallback OnSettingsRequested { get; set; }
    [Parameter] public EventCallback OnExportRequested { get; set; }
    [Parameter] public EventCallback OnManageLabelsRequested { get; set; }
    [Parameter] public bool ShowFilters { get; set; }
    [Parameter] public bool HasActiveFilters { get; set; }
    [Parameter] public EventCallback OnToggleFilters { get; set; }

    private bool isOpen;
    private string currentView = "board";

    private void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    private void CloseMenu()
    {
        isOpen = false;
    }

    private async Task SetView(string view)
    {
        currentView = view;
        await ViewChanged.InvokeAsync(view);
    }

    private async Task OnNewBoard()
    {
        CloseMenu();
        await OnNewBoardRequested.InvokeAsync();
    }

    private async Task OnSettings()
    {
        CloseMenu();
        await OnSettingsRequested.InvokeAsync();
    }

    private async Task OnExport()
    {
        CloseMenu();
        await OnExportRequested.InvokeAsync();
    }

    private async Task OnManageLabels()
    {
        CloseMenu();
        await OnManageLabelsRequested.InvokeAsync();
    }

    private async Task ToggleFilters()
    {
        await OnToggleFilters.InvokeAsync();
    }

    private void OnLogout()
    {
        CloseMenu();
    }
}
