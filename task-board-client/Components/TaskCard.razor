@using task_board_client.Models

<div class="task-card"
     draggable="true"
     @ondragstart="OnDragStart">

    @if (!string.IsNullOrWhiteSpace(Task.Labels))
    {
        <div class="card-labels">
            @foreach (var label in Task.Labels.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                <span class="card-label-text" style="background: @GetLabelColor(label)">@label</span>
            }
        </div>
    }
    else
    {
        <div class="card-labels">
            <span class="card-label @LabelClass"></span>
        </div>
    }

    <div class="card-title">@Task.Title</div>
    @if (!string.IsNullOrWhiteSpace(Task.Description))
    {
        <div class="card-description">@Task.Description</div>
    }

    <div class="card-footer">
        <div class="card-badges">
            @if (Task.DueDate.HasValue)
            {
                var daysLeft = (Task.DueDate.Value.Date - DateTime.Today).Days;
                <span class="badge badge-date @(daysLeft < 0 ? "badge-overdue" : daysLeft == 0 ? "badge-today" : "")">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    @Task.DueDate.Value.ToString("dd MMM")
                </span>
            }
        </div>
        <div class="card-avatars">
            <div class="mini-avatar">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@Task.Id" alt="avatar" />
            </div>
        </div>
    </div>

    <button class="card-action-btn card-edit-btn" @onclick="OnEdit" data-tooltip="Editar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
    </button>

    <button class="card-action-btn card-archive-btn" @onclick="OnArchive" data-tooltip="Archivar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="21 8 21 21 3 21 3 8"></polyline>
            <rect x="1" y="3" width="22" height="5"></rect>
            <line x1="10" y1="12" x2="14" y2="12"></line>
        </svg>
    </button>

    <button class="card-action-btn card-delete-btn" @onclick="OnDelete" data-tooltip="Eliminar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
</div>

<style>
    .task-card {
        background: white;
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 8px;
        box-shadow: 0 1px 1px rgba(9, 30, 66, 0.25);
        cursor: grab;
        position: relative;
        transition: box-shadow 0.15s, background 0.15s;
        border: 1px solid transparent;
    }

    .task-card:hover {
        background: #f7f8f9;
        border-color: #d0d4dc;
    }

    .task-card:active {
        cursor: grabbing;
    }

    .card-labels {
        display: flex;
        gap: 4px;
        margin-bottom: 6px;
    }

    .card-label {
        height: 8px;
        width: 40px;
        border-radius: 4px;
    }

    .label-yellow { background: #f5cd47; }
    .label-blue { background: #579dff; }
    .label-green { background: #4bce97; }
    .label-pink { background: #f472b6; }
    .label-purple { background: #9f8fef; }
    .label-orange { background: #fea362; }

    .card-label-text {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
        color: white;
        line-height: 1.4;
    }

    .card-title {
        font-size: 0.85rem;
        color: #172b4d;
        line-height: 1.4;
        margin-bottom: 2px;
        word-wrap: break-word;
    }

    .card-description {
        font-size: 0.75rem;
        color: #626f86;
        line-height: 1.4;
        margin-bottom: 4px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 4px;
    }

    .card-badges {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .badge {
        display: flex;
        align-items: center;
        gap: 3px;
        color: #626f86;
    }

    .badge-date {
        font-size: 0.7rem;
        font-weight: 500;
    }

    .badge-overdue {
        color: #ae1e09;
        background: #ffeceb;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .badge-today {
        color: #856404;
        background: #fff3cd;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .card-avatars {
        display: flex;
    }

    .mini-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid white;
        margin-left: -6px;
    }

    .mini-avatar:first-child {
        margin-left: 0;
    }

    .mini-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-action-btn {
        position: absolute;
        top: 4px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #d0d4dc;
        border-radius: 4px;
        color: #626f86;
        cursor: pointer;
        padding: 4px;
        display: none;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    }

    .card-edit-btn {
        right: 52px;
    }

    .card-archive-btn {
        right: 28px;
    }

    .card-delete-btn {
        right: 4px;
    }

    .task-card:hover .card-action-btn {
        display: flex;
    }

    .card-action-btn:hover {
        background: #f1f2f4;
        color: #172b4d;
    }

    .card-delete-btn:hover {
        background: #ffeceb;
        color: #ae1e09;
        border-color: #ff5630;
    }

    .card-archive-btn:hover {
        background: #e3fcef;
        color: #006644;
        border-color: #36b37e;
    }

    @@media (max-width: 640px) {
        .task-card {
            padding: 6px 8px;
        }

        .card-action-btn {
            display: flex;
            opacity: 0.6;
        }

        .task-card:hover .card-action-btn {
            opacity: 1;
        }

        .card-description {
            white-space: normal;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }
    }
</style>

@code {
    [Parameter] public TaskItem Task { get; set; } = default!;
    [Parameter] public string LabelClass { get; set; } = "label-yellow";
    [Parameter] public EventCallback<int> DragStarted { get; set; }
    [Parameter] public EventCallback<int> DeleteClicked { get; set; }
    [Parameter] public EventCallback<int> EditClicked { get; set; }
    [Parameter] public EventCallback<int> ArchiveClicked { get; set; }

    private void OnDragStart()
    {
        DragStarted.InvokeAsync(Task.Id);
    }

    private void OnEdit()
    {
        EditClicked.InvokeAsync(Task.Id);
    }

    private void OnDelete()
    {
        DeleteClicked.InvokeAsync(Task.Id);
    }

    private void OnArchive()
    {
        ArchiveClicked.InvokeAsync(Task.Id);
    }

    private string GetLabelColor(string label)
    {
        return label.Trim() switch
        {
            "Alta" => "#ff5630",
            "Media" => "#ff991f",
            "Baja" => "#36b37e",
            "Bug" => "#ff5630",
            "Feature" => "#579dff",
            "Mejora" => "#9f8fef",
            "Urgente" => "#e8916d",
            "Diseño" => "#f472b6",
            _ => "#626f86"
        };
    }
}
