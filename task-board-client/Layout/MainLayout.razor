@inherits LayoutComponentBase
@using task_board_client.Services
@using task_board_client.Components
@inject BoardService BoardService

<div class="trello-app @(sidebarOpen ? "sidebar-open" : "")">
    <aside class="sidebar @(sidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <span class="sidebar-logo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
                Task Board
            </span>
            <button class="sidebar-close" @onclick="ToggleSidebar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="sidebar-content">
            <div class="sidebar-section">
                <div class="sidebar-section-title">Esenciales</div>
                <button class="sidebar-item" @onclick="OnNewBoard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Nuevo tablero
                </button>
                <button class="sidebar-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    Configuración
                </button>
                <button class="sidebar-item" @onclick="OnExport">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    Exportar tablero
                </button>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-section-title">Utilidades</div>
                <div class="sidebar-item-group">
                    <span class="sidebar-item-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                        </svg>
                        Cambiar vista
                    </span>
                    <div class="sidebar-view-options">
                        <button class="sidebar-view-btn @(currentView == "board" ? "active" : "")" @onclick='() => SetView("board")'>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="5" height="18" rx="1"></rect>
                                <rect x="10" y="3" width="5" height="12" rx="1"></rect>
                                <rect x="17" y="3" width="5" height="15" rx="1"></rect>
                            </svg>
                            Tablero
                        </button>
                        <button class="sidebar-view-btn @(currentView == "list" ? "active" : "")" @onclick='() => SetView("list")'>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="8" y1="6" x2="21" y2="6"></line>
                                <line x1="8" y1="12" x2="21" y2="12"></line>
                                <line x1="8" y1="18" x2="21" y2="18"></line>
                                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                <line x1="3" y1="18" x2="3.01" y2="18"></line>
                            </svg>
                            Lista
                        </button>
                        <button class="sidebar-view-btn @(currentView == "calendar" ? "active" : "")" @onclick='() => SetView("calendar")'>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            Calendario
                        </button>
                    </div>
                </div>
                <button class="sidebar-item" @onclick="OnToggleFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    Filtros y búsqueda
                </button>
                <button class="sidebar-item" @onclick="OnManageLabels">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    Administrar etiquetas
                </button>
            </div>

            <div class="sidebar-divider"></div>

            <div class="sidebar-section">
                <div class="sidebar-shortcuts">
                    <div class="sidebar-shortcuts-title">Atajos de teclado</div>
                    <div class="sidebar-shortcut-row"><kbd>N</kbd> Nueva columna</div>
                    <div class="sidebar-shortcut-row"><kbd>E</kbd> Editar primera tarea</div>
                    <div class="sidebar-shortcut-row"><kbd>Ctrl+Z</kbd> Deshacer</div>
                    <div class="sidebar-shortcut-row"><kbd>Esc</kbd> Cerrar modal</div>
                </div>
            </div>

            <div class="sidebar-divider"></div>

            <div class="sidebar-section">
                <div class="sidebar-item-group">
                    <span class="sidebar-item-label">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Mi perfil
                    </span>
                    <span class="sidebar-user-name">Edinson</span>
                </div>
                <button class="sidebar-item sidebar-item-danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Cerrar sesión
                </button>
            </div>
        </div>
    </aside>

    <div class="trello-content">
        <header class="trello-header">
            <div class="header-left">
                <button class="header-icon-btn" @onclick="ToggleSidebar" data-tooltip="Menú">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <div class="header-logo">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                        <rect x="1" y="1" width="10" height="20" rx="2" fill="white"/>
                        <rect x="13" y="1" width="10" height="13" rx="2" fill="white"/>
                    </svg>
                    <span class="logo-text">Task Board</span>
                </div>
            </div>
            <div class="header-center">
                <span class="board-title">Team board</span>
                <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </div>
            <div class="header-right">
                <button class="invite-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <line x1="19" y1="8" x2="19" y2="14"></line>
                        <line x1="22" y1="11" x2="16" y2="11"></line>
                    </svg>
                    Invite
                </button>
                <div class="user-avatar">
                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="User" />
                </div>
            </div>
        </header>

        <main class="trello-main">
            @Body
        </main>
    </div>
</div>

<style>
    .trello-app {
        display: flex;
        height: 100vh;
        overflow: hidden;
    }

    .sidebar {
        width: 280px;
        min-width: 280px;
        height: 100vh;
        background: #f7f8f9;
        display: flex;
        flex-direction: column;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        z-index: 100;
        box-shadow: none;
    }

    .sidebar.open {
        transform: translateX(0);
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.1);
    }

    .trello-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 16px 12px;
        border-bottom: 1px solid #dfe1e6;
    }

    .sidebar-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 1rem;
        color: #172b4d;
    }

    .sidebar-close {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 4px;
        color: #626f86;
        display: flex;
        align-items: center;
        transition: background 0.15s;
    }

    .sidebar-close:hover {
        background: #dfe1e6;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
    }

    .sidebar-section {
        padding: 8px 12px;
    }

    .sidebar-section-title {
        font-size: 0.7rem;
        font-weight: 600;
        color: #626f86;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 8px;
        margin-bottom: 2px;
    }

    .sidebar-item {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border: none;
        background: none;
        color: #172b4d;
        font-size: 0.85rem;
        cursor: pointer;
        border-radius: 6px;
        text-align: left;
        transition: background 0.1s;
    }

    .sidebar-item:hover {
        background: #e4e7eb;
    }

    .sidebar-item svg {
        color: #626f86;
        flex-shrink: 0;
    }

    .sidebar-item-danger {
        color: #ae1e09;
    }

    .sidebar-item-danger svg {
        color: #ae1e09;
    }

    .sidebar-item-danger:hover {
        background: #ffeceb;
    }

    .sidebar-item-group {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        border-radius: 6px;
    }

    .sidebar-item-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        color: #172b4d;
    }

    .sidebar-item-label svg {
        color: #626f86;
    }

    .sidebar-user-name {
        font-size: 0.8rem;
        color: #626f86;
    }

    .sidebar-view-options {
        display: flex;
        gap: 4px;
        background: #dfe1e6;
        border-radius: 6px;
        padding: 3px;
    }

    .sidebar-view-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border: none;
        background: none;
        color: #626f86;
        font-size: 0.75rem;
        cursor: pointer;
        border-radius: 4px;
        transition: all 0.15s;
        white-space: nowrap;
    }

    .sidebar-view-btn.active {
        background: white;
        color: #172b4d;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .sidebar-view-btn:hover:not(.active) {
        color: #172b4d;
    }

    .sidebar-divider {
        height: 1px;
        background: #dfe1e6;
        margin: 4px 12px;
    }

    .sidebar-shortcuts {
        padding: 4px 10px;
    }

    .sidebar-shortcuts-title {
        font-size: 0.7rem;
        font-weight: 600;
        color: #626f86;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .sidebar-shortcut-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 0.8rem;
        color: #44546f;
    }

    .sidebar-shortcut-row kbd {
        background: #e4e7eb;
        border: 1px solid #d0d4dc;
        border-radius: 4px;
        padding: 1px 6px;
        font-family: monospace;
        font-size: 0.7rem;
        color: #172b4d;
        min-width: 24px;
        text-align: center;
    }

    .trello-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        height: 56px;
        min-height: 56px;
        background: linear-gradient(135deg, #0c66e4 0%, #0055cc 100%);
        color: white;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .header-icon-btn {
        background: none;
        border: none;
        color: rgba(255,255,255,0.85);
        cursor: pointer;
        padding: 6px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background 0.15s;
    }

    .header-icon-btn:hover {
        background: rgba(255,255,255,0.15);
    }

    .header-logo {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logo-text {
        font-weight: 700;
        font-size: 1.1rem;
    }

    .header-center {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .board-title {
        font-weight: 600;
        font-size: 1rem;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .invite-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background 0.15s;
    }

    .invite-btn:hover {
        background: rgba(255,255,255,0.3);
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.4);
    }

    .user-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .trello-main {
        flex: 1;
        overflow: hidden;
    }

    @@media (max-width: 640px) {
        .sidebar {
            width: 260px;
            min-width: 260px;
        }

        .header-center {
            display: none;
        }

        .invite-btn span {
            display: none;
        }
    }
</style>

@code {
    private bool sidebarOpen;
    private string currentView = "board";

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
        StateHasChanged();
    }

    private async Task SetView(string view)
    {
        currentView = view;
        BoardService.ChangeView(view);
    }

    private void OnNewBoard()
    {
        BoardService.NewBoard();
    }

    private async Task OnExport()
    {
        await BoardService.Export();
    }

    private void OnToggleFilters()
    {
        BoardService.ToggleFilters();
    }

    private void OnManageLabels()
    {
        BoardService.ManageLabels();
    }
}
