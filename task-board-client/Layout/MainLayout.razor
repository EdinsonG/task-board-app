@inherits LayoutComponentBase
@using task_board_client.Services
@using task_board_client.Components
@inject BoardService BoardService

<div class="trello-app">
    <header class="trello-header">
        <div class="header-left">
            <HamburgerMenu OnToggleFilters="() => BoardService.ToggleFilters()"
                           OnExportRequested="async () => await BoardService.Export()"
                           OnManageLabelsRequested="() => BoardService.ManageLabels()"
                           OnNewBoardRequested="() => BoardService.NewBoard()"
                           ViewChanged="view => BoardService.ChangeView(view)" />
            <div class="header-logo">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                    <rect x="1" y="1" width="10" height="20" rx="2" fill="white"/>
                    <rect x="13" y="1" width="10" height="13" rx="2" fill="white"/>
                </svg>
                <span class="logo-text">Task Board</span>
            </div>
        </div>
        <div class="header-center">
            <span class="board-title">Team board</span>
            <svg class="star-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
        </div>
        <div class="header-right">
            <button class="invite-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="19" y1="8" x2="19" y2="14"></line>
                    <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
                Invite
            </button>
            <div class="user-avatar">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="User" />
            </div>
        </div>
    </header>

    <main class="trello-main">
        @Body
    </main>
</div>
